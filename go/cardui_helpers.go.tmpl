// Code generated by card-ui. Shared by every card exported from card-ui;
// change card-ui/go/cardui_helpers.go.tmpl and export again instead of editing by hand.

package card_generator

import (
	"employee-card-admin/assets/fonts"
	"image"
	"image/color"
	"image/draw"
	"strings"

	"github.com/fogleman/gg"
	"golang.org/x/image/font"
)

// cardUITextSegment is one styled run inside a single line of rich text.
type cardUITextSegment struct {
	Text  string
	Face  font.Face
	Color color.Color
}

// cardUIDrawSegments draws styled runs side by side as one line anchored at (x, y).
// Each run is vertically anchored with its own font height, like drawText.
func cardUIDrawSegments(dc *gg.Context, segments []cardUITextSegment, x, y, ax, ay float64) {
	widths := make([]float64, len(segments))
	total := 0.0
	for i, seg := range segments {
		dc.SetFontFace(seg.Face)
		widths[i], _ = dc.MeasureString(seg.Text)
		total += widths[i]
	}
	cursor := x - ax*total
	for i, seg := range segments {
		drawText(dc, seg.Text, cursor, y, seg.Face, seg.Color, 0, ay)
		cursor += widths[i]
	}
}

// cardUIWrapLines greedily wraps text into lines no wider than maxWidth using the
// current font face. When maxLines > 0 any overflow is merged into the last line.
func cardUIWrapLines(dc *gg.Context, text string, maxWidth float64, maxLines int) []string {
	words := strings.Fields(text)
	if len(words) == 0 {
		return []string{""}
	}
	var lines []string
	current := words[0]
	for _, word := range words[1:] {
		candidate := current + " " + word
		if w, _ := dc.MeasureString(candidate); w <= maxWidth {
			current = candidate
			continue
		}
		lines = append(lines, current)
		current = word
	}
	lines = append(lines, current)
	if maxLines > 0 && len(lines) > maxLines {
		lines = append(lines[:maxLines-1], strings.Join(lines[maxLines-1:], " "))
	}
	return lines
}

// cardUIFitLines shrinks the font from size towards minSize until text wraps into
// at most maxLines lines that all fit within maxWidth.
func cardUIFitLines(dc *gg.Context, text string, maxWidth float64, ttf []byte, size, minSize, step float64, maxLines int) ([]string, font.Face) {
	if step <= 0 {
		step = 1
	}
	for s := size; s >= minSize; s -= step {
		face := mustFont(ttf, s)
		dc.SetFontFace(face)
		lines := cardUIWrapLines(dc, text, maxWidth, 0)
		if len(lines) <= maxLines && cardUILinesFit(dc, lines, maxWidth) {
			return lines, face
		}
	}
	face := mustFont(ttf, minSize)
	dc.SetFontFace(face)
	return cardUIWrapLines(dc, text, maxWidth, maxLines), face
}

func cardUILinesFit(dc *gg.Context, lines []string, maxWidth float64) bool {
	for _, line := range lines {
		if w, _ := dc.MeasureString(line); w > maxWidth {
			return false
		}
	}
	return true
}

// cardUIDrawCircleAvatar draws the avatar cropped to a circle (cover fit) with an
// optional border, falling back to an initials badge when it cannot be loaded.
func cardUIDrawCircleAvatar(dc *gg.Context, cx, cy, radius float64, avatarURL, initials string, border color.Color, borderWidth float64) {
	drawn := false
	if strings.TrimSpace(avatarURL) != "" {
		if img, err := loadImageFromURIOrURL(avatarURL); err == nil && img != nil {
			dc.Push()
			dc.DrawCircle(cx, cy, radius)
			dc.Clip()
			drawImageCover(dc, img, cx-radius, cy-radius, radius*2, radius*2)
			dc.Pop()
			dc.ResetClip()
			drawn = true
		}
	}
	if !drawn {
		drawCircle(dc, cx, cy, radius, hexColor("#ede9fe"))
		drawText(dc, fallbackString(initials, "NA"), cx, cy, mustFont(fonts.AptosBold, radius*0.75), hexColor("#6d28d9"), 0.5, 0.5)
	}
	if borderWidth > 0 {
		dc.DrawCircle(cx, cy, radius)
		dc.SetColor(border)
		dc.SetLineWidth(borderWidth)
		dc.Stroke()
	}
}

// cardUIRoundCorners makes everything outside a rounded rectangle of the given
// radius transparent.
func cardUIRoundCorners(img image.Image, radius float64) image.Image {
	b := img.Bounds()
	mask := gg.NewContext(b.Dx(), b.Dy())
	mask.DrawRoundedRectangle(0, 0, float64(b.Dx()), float64(b.Dy()), radius)
	mask.SetColor(color.White)
	mask.Fill()
	out := image.NewRGBA(b)
	draw.DrawMask(out, b, img, b.Min, mask.Image(), image.Point{}, draw.Src)
	return out
}
